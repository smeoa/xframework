# 环境变量模板：复制为对应环境文件后填写，禁止提交真实密钥
SITE_URL=

# 前台 API 基址（FastAPI site/main.py）
NUXT_PUBLIC_API_BASE=
NUXT_PUBLIC_FORM_ENDPOINT=
NUXT_PUBLIC_UPLOAD_ENDPOINT=/front/upload/files
# P3 语言 / 货币切换开关，默认关闭
NUXT_PUBLIC_I18N_ENABLED=false

FORM_WEBHOOK_URL=
CRM_WEBHOOK_URL=
FILE_UPLOAD_ENDPOINT=

MAIL_PROVIDER_API_KEY=
